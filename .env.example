# Copy to .env and supply a local development password. Never commit .env.
WHO_POSTGRES_HOST=127.0.0.1
WHO_POSTGRES_DB=who_dev
WHO_POSTGRES_USER=who_dev
WHO_POSTGRES_PASSWORD=
WHO_POSTGRES_PORT=5432
WHO_MAILPIT_SMTP_PORT=1025
WHO_MAILPIT_WEB_PORT=8025
WHO_API_URL=http://127.0.0.1:5080

# Base64, at least 32 decoded random bytes each. Never commit real values.
WHO_AUTH_VERIFICATION_PEPPER=
WHO_AUTH_JWT_SIGNING_KEY=
WHO_AUTH_JWT_ISSUER=who-local
WHO_AUTH_JWT_AUDIENCE=who-local-client
WHO_SMTP_HOST=127.0.0.1
WHO_SMTP_PORT=1025
WHO_SMTP_FROM='WHO? <no-reply@who.local>'
# Requests per IP per 60-second fixed window.
WHO_AUTH_RATE_REGISTER=5
WHO_AUTH_RATE_LOGIN=10
WHO_AUTH_RATE_VERIFY=20
WHO_AUTH_RATE_RESEND=5
WHO_AUTH_RATE_REFRESH=30
